<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="calculadoraGrid.MainPage">

    <Grid
        Padding="20"
        RowSpacing="10"
        ColumnSpacing="10"
        RowDefinitions="2*,*,*,*,*,*"
        ColumnDefinitions="*,*,*,*">

        <!-- Pantalla -->
        <Entry
            x:Name="Pantalla"
            Grid.Row="0"
            Grid.ColumnSpan="4"
            Text="0"
            FontSize="40"
            HorizontalTextAlignment="End"
            VerticalTextAlignment="Center"
            IsReadOnly="True" />

        <!-- Fila 1 -->
        <Button
            Text="C"
            Grid.Row="1"
            Grid.Column="0"
            Clicked="Limpiar_Clicked" />

        <Button
            Text="÷"
            Grid.Row="1"
            Grid.Column="3"
            Clicked="Operacion_Clicked" />

        <!-- Fila 2 -->
        <Button Text="7" Grid.Row="2" Grid.Column="0" Clicked="Numero_Clicked" />
        <Button Text="8" Grid.Row="2" Grid.Column="1" Clicked="Numero_Clicked" />
        <Button Text="9" Grid.Row="2" Grid.Column="2" Clicked="Numero_Clicked" />
        <Button Text="×" Grid.Row="2" Grid.Column="3" Clicked="Operacion_Clicked" />

        <!-- Fila 3 -->
        <Button Text="4" Grid.Row="3" Grid.Column="0" Clicked="Numero_Clicked" />
        <Button Text="5" Grid.Row="3" Grid.Column="1" Clicked="Numero_Clicked" />
        <Button Text="6" Grid.Row="3" Grid.Column="2" Clicked="Numero_Clicked" />
        <Button Text="-" Grid.Row="3" Grid.Column="3" Clicked="Operacion_Clicked" />

        <!-- Fila 4 -->
        <Button Text="1" Grid.Row="4" Grid.Column="0" Clicked="Numero_Clicked" />
        <Button Text="2" Grid.Row="4" Grid.Column="1" Clicked="Numero_Clicked" />
        <Button Text="3" Grid.Row="4" Grid.Column="2" Clicked="Numero_Clicked" />
        <Button Text="+" Grid.Row="4" Grid.Column="3" Clicked="Operacion_Clicked" />

        <!-- Fila 5 -->
        <Button
            Text="0"
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Clicked="Numero_Clicked" />

        <Button
            Text="="
            Grid.Row="5"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Clicked="Igual_Clicked" />

    </Grid>


</ContentPage>
